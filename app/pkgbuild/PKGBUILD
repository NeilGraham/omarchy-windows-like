pkgname=windows-like-settings
pkgver=0.1.0
pkgrel=1
pkgdesc='Settings for omarchy-windows-like: taskbar and Start, snapping, tabs'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'hicolor-icon-theme' 'jq')
makedepends=('gcc' 'make')
# No separate -debug package: the binary is built without debug symbols.
options=('!debug')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/windows-like-settings "$pkgdir/usr/bin/windows-like-settings"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/windows-like-settings.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/windows-like-settings.svg"
  install -Dm644 "$startdir/windows-like-settings.desktop" "$pkgdir/usr/share/applications/windows-like-settings.desktop"
  # The plugin's defaults, so the app can say what each setting is even
  # before the plugin is set up.
  install -Dm644 ../config/defaults.json "$pkgdir/usr/share/windows-like-settings/defaults.json"
}
